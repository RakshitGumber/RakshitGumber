---
import Anchor from "../components/common/Anchor.astro";
import Breadcrumbs from "../components/Breadcrumbs.astro";
import Section from "../components/common/Section.astro";
import Prose from "../components/Prose.astro";
import Seo from "../components/Seo.astro";
import type { ProjectFrontmatter } from "../libs/types";
import { buildBreadcrumbListJsonLd, getSiteUrl } from "@/libs/seo";
import Layout from "./Layout.astro";

type Props = { frontmatter: ProjectFrontmatter };

const { frontmatter } = Astro.props;
const siteUrl = getSiteUrl();
const canonicalPath = `/projects/${frontmatter.slug}`;
const description = frontmatter.longDescription ?? frontmatter.description;
const breadcrumbs = [
  { name: "Projects", href: "/projects" },
  { name: frontmatter.title, href: canonicalPath },
];
const breadcrumbJsonLd = buildBreadcrumbListJsonLd(breadcrumbs, siteUrl);
---

<Layout>
  <Fragment slot="head">
    <Seo
      title={`${frontmatter.title} | Projects | Rakshit Gumber`}
      description={description}
      path={canonicalPath}
      image={frontmatter.cardImage}
      jsonLd={breadcrumbJsonLd}
    />
  </Fragment>
  <Section>
    <Breadcrumbs items={breadcrumbs} class="mb-10" />
    <div class="flex flex-col gap-4 mt-8 mb-16">
      <h1
        class="font-heading text-3xl leading-tight text-title-color sm:text-4xl"
      >
        {frontmatter.title}
      </h1>

      <div class="flex gap-2">
        {
          frontmatter.githubUrl ? (
            <Anchor url={frontmatter.githubUrl} class="text-base" external>
              GitHub
            </Anchor>
          ) : null
        }
        {
          frontmatter.liveDemoUrl ? (
            <Anchor url={frontmatter.liveDemoUrl} class="text-base" external>
              Demo
            </Anchor>
          ) : null
        }
      </div>
    </div>
    <Prose>
      <slot />
    </Prose>
  </Section>
</Layout>
