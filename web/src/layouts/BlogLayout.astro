---
import Section from "../components/common/Section.astro";
import Prose from "../components/Prose.astro";
import Breadcrumbs from "../components/Breadcrumbs.astro";
import Seo from "../components/Seo.astro";
import type { ArticleFrontmatter } from "../libs/types";
import { processArticleDate } from "../libs/utils";
import {
  buildBlogPostingJsonLd,
  buildBreadcrumbListJsonLd,
  getSiteUrl,
  SITE_NAME,
} from "@/libs/seo";
import Layout from "./Layout.astro";

type Props = { frontmatter: ArticleFrontmatter };

const { frontmatter } = Astro.props;
const articleDate = processArticleDate(frontmatter.timestamp);
const siteUrl = getSiteUrl();
const canonicalPath = `/blog/${frontmatter.slug}`;
const description = frontmatter.longDescription ?? frontmatter.description;
const breadcrumbs = [
  { name: "Blog", href: "/blog" },
  { name: frontmatter.title, href: canonicalPath },
];
const articleJsonLd = buildBlogPostingJsonLd(siteUrl, {
  title: frontmatter.title,
  description,
  url: canonicalPath,
  image: frontmatter.cardImage,
  datePublished: frontmatter.timestamp.toISOString(),
  dateModified: frontmatter.timestamp.toISOString(),
  authorName: SITE_NAME,
  keywords: frontmatter.tags ?? [],
});
const breadcrumbJsonLd = buildBreadcrumbListJsonLd(breadcrumbs, siteUrl);
---

<Layout>
  <Fragment slot="head">
    <Seo
      title={`${frontmatter.title} | Blog | Rakshit Gumber`}
      description={description}
      path={canonicalPath}
      type="article"
      image={frontmatter.cardImage}
      publishedTime={frontmatter.timestamp.toISOString()}
      modifiedTime={frontmatter.timestamp.toISOString()}
      jsonLd={[articleJsonLd, breadcrumbJsonLd]}
    />
  </Fragment>
  <Section class="pt-8">
    <Breadcrumbs items={breadcrumbs} class="mb-10" />
    <div class="flex flex-col gap-4 mt-8 mb-16">
      <h1
        class="font-heading text-3xl leading-normal text-title-color sm:text-4xl sm:leading-normal font-bold"
      >
        {frontmatter.title}
      </h1>
      <div class="flex justify-between">
        <span>{articleDate}</span>
        <span>{frontmatter.readTime} min</span>
      </div>
    </div>
    <Prose>
      <slot />
    </Prose>
    <p class="pt-8">~Rakshit Gumber</p>
  </Section>
</Layout>
