---
import Seo from "@/components/Seo.astro";
import Section from "../components/common/Section.astro";
import Layout from "../layouts/Layout.astro";
---

<Layout>
  <Fragment slot="head">
    <Seo
      title="404 - Page Not Found | Rakshit Gumber"
      description="The page you are looking for does not exist."
      path="/404"
      canonicalPath={null}
      robots={{ index: false, follow: false }}
      fallbackImage={false}
    />
  </Fragment>
  <Section class="mt-16">
    <h1 class="pb-8 font-heading text-3xl text-title-color sm:text-4xl">
      Well, this is awkward
    </h1>
    <h2 class="text-xl sm:text-2xl pb-8">404 - Page not found</h2>
    <p>
      It seems that this page does not exist. If you want to return to safety, <a
        class="underline underline-offset-4 font-medium"
        href="/">click here to go home</a
      >.
    </p>
  </Section>
</Layout>
