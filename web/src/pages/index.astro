---
import { getCollection } from "astro:content";
import Seo from "@/components/Seo.astro";
import Section from "../components/common/Section.astro";
import FeaturedArticles from "../components/home/FeaturedArticles.astro";
import FeaturedProjects from "../components/home/FeaturedProjects.astro";
import Hero from "../components/home/Hero.astro";
import Layout from "../layouts/Layout.astro";
import {
  buildPersonJsonLd,
  buildProfilePageJsonLd,
  getSiteUrl,
  SAME_AS_LINKS,
  SITE_NAME,
} from "@/libs/seo";

const featuredProjects = (
  await getCollection("project", (e) => e.data.featured)
).map((e) => ({
  ...e.data,
  url: `/projects/${e.data.slug}`,
}));
const featuredArticles = (
  await getCollection("blog", (e) => e.data.featured)
).map((e) => ({
  ...e.data,
  url: `/blog/${e.data.slug}`,
}));
const siteUrl = getSiteUrl();
const personJsonLd = buildPersonJsonLd(siteUrl, {
  name: SITE_NAME,
  description:
    "Portfolio, projects, and writing by Rakshit Gumber, a developer focused on shipping useful work.",
  url: "/",
  image: "/images/avatar.png",
  sameAs: SAME_AS_LINKS,
});
const profilePageJsonLd = buildProfilePageJsonLd(siteUrl, {
  name: SITE_NAME,
  description:
    "Portfolio, projects, and writing by Rakshit Gumber, a developer focused on shipping useful work.",
  url: "/",
  mainEntity: personJsonLd,
});
---

<Layout>
  <Fragment slot="head">
    <Seo
      title="Rakshit Gumber | Curious"
      description="Portfolio, projects, and writing by Rakshit Gumber, a developer focused on shipping useful work."
      path="/"
      jsonLd={[personJsonLd, profilePageJsonLd]}
    />
  </Fragment>
  <Section class="my-12 sm:my-16">
    <Hero />
  </Section>
  <Section>
    <FeaturedProjects featuredProjects={featuredProjects} />
  </Section>
  <Section>
    <FeaturedArticles featuredArticles={featuredArticles} />
  </Section>
</Layout>
