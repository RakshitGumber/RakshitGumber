---
import { getCollection } from "astro:content";
import Section from "../components/common/Section.astro";
import FeaturedArticles from "../components/home/FeaturedArticles.astro";
import FeaturedProjects from "../components/home/FeaturedProjects.astro";
import Hero from "../components/home/Hero.astro";
import Layout from "../layouts/Layout.astro";

const featuredProjects = (
  await getCollection("project", (e) => e.data.featured)
).map((e) => ({
  ...e.data,
  url: `/projects/${e.data.slug}`,
}));
const featuredArticles = (
  await getCollection("blog", (e) => e.data.featured)
).map((e) => ({
  ...e.data,
  url: `/blog/${e.data.slug}`,
}));
---

<Layout>
  <Fragment slot="head">
    <title>Rakshit Gumber</title>
    <meta
      name="description"
      content="Personal site, writing, and projects by Rakshit Gumber."
    />
    <meta property="og:title" content="Rakshit Gumber" />
    <meta
      property="og:description"
      content="Personal site, writing, and projects by Rakshit Gumber."
    />
    <meta
      name="keywords"
      content="Rakshit Gumber, portfolio, projects, blog"
    />
    <meta property="og:url" content="/" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content="Rakshit Gumber" />
    <meta
      name="twitter:description"
      content="Personal site, writing, and projects by Rakshit Gumber."
    />
    <meta http-equiv="content-language" content="en" />
    <meta name="language" content="English" />
    <link rel="canonical" href="/" />
  </Fragment>
  <Section class="my-12 sm:my-16">
    <Hero />
  </Section>
  <Section>
    <FeaturedProjects featuredProjects={featuredProjects} />
  </Section>
  <Section>
    <FeaturedArticles featuredArticles={featuredArticles} />
  </Section>
</Layout>
