---
import type { ArticleFrontmatter } from "../../libs/types";
import ArticleSnippet from "../ArticleSnippet.astro";
import Anchor from "../common/Anchor.astro";

type Props = {
  featuredArticles: Array<ArticleFrontmatter>;
};

const { featuredArticles } = Astro.props;
---

<div class="flex justify-between items-center w-full">
  <h3 class="font-heading text-lg leading-loose text-title-color sm:text-xl">
    Articles
  </h3>
  <Anchor url="/blog" class="text-base">View All</Anchor>
</div>
<ul class="my-8">
  {
    (featuredArticles.length === 0 && <p>No articles found.</p>) ||
      featuredArticles.map((article) => (
        <li>
          <ArticleSnippet
            title={article.title}
            description={article.description}
            url={article.url}
            timestamp={article.timestamp}
            duration={`${article.readTime} min`}
          />
        </li>
      ))
  }
</ul>
