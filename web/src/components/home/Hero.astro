---
import Anchor from "../common/Anchor.astro";
---

<div class="flex sm:flex-row flex-col items-start gap-12">
  <div class="flex flex-col gap-4 order-2">
    <h1
      class="font-heading text-4xl font-bold text-title-color sm:text-6xl lg:text-7xl"
    >
      Rakshit Gumber
    </h1>
    <p
      class="font-content text-xl font-semibold leading-relaxed text-text-color sm:text-2xl"
    >
      Driven by curiosity, Building with Passion.
    </p>
    <Anchor url="https://www.linkedin.com/in/gumber-rakshit" external>
      <button class="px-5 py-2 bg-accent text-title-color text-lg font-semibold"
        >Let's work
      </button>
    </Anchor>
  </div>

  <div class="h-70 min-w-60 order-1 border-2 border-border-color">
    <img
      src="/images/avatar.png"
      alt="Portrait of Rakshit Gumber"
      class="object-cover object-top h-full w-full"
      loading="eager"
    />
  </div>
</div>
