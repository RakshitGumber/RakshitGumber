---
import { getConfigurationCollection } from "../../libs/utils";

const { data: config } = await getConfigurationCollection();
---

<div class="flex flex-col gap-8 sm:flex-row sm:items-center">
  {
    config.hero.image && (
      <img
        src={config.hero.image}
        alt={`${config.hero.title} profile image`}
        class="z-0 mb-4 h-40 w-40 max-w-40 rounded-full object-cover grayscale"
      />
    )
  }
  <div>
    <h1
      class="text-center font-heading text-3xl font-semibold text-title-color sm:text-left sm:text-4xl"
    >
      {config.hero.title}
    </h1>
    <h2
      class="text-center font-mono text-xl font-medium text-text-color sm:text-left sm:text-2xl"
    >
      <p set:html={config.hero.subtitle} />
    </h2>
  </div>
</div>
