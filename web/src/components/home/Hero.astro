---
import Anchor from "../common/Anchor.astro";
---

<main class="min-h-100 flex sm:flex-row flex-col items-start gap-12">
  <div class="flex flex-col gap-6 order-2">
    <h1
      class="font-heading text-4xl font-bold text-title-color sm:text-6xl lg:text-7xl"
    >
      Rakshit Gumber
    </h1>
    <p
      class="font-content text-2xl font-semibold leading-relaxed text-text-color sm:text-2x px-0.5"
    >
      Working with Curiosity, Building with Passion.
    </p>
    <Anchor url="/contact" class="w-fit">
      <button
        class="px-5 py-2 bg-accent text-title-color text-lg font-semibold cursor-pointer"
        >Let's work
      </button>
    </Anchor>
  </div>

  <div class="h-90 min-w-80 order-1">
    <img
      src="/images/avatar.png"
      alt="Portrait of Rakshit Gumber"
      class="object-cover object-top h-full w-full"
      loading="eager"
    />
  </div>
</main>
