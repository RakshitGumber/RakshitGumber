---
import Anchor from "../common/Anchor.astro";
---

<div class="flex flex-col items-start gap-8">
  <div class="flex">
    <div class="h-65 min-w-60 border-2 border-border-color">
      <img
        src="/images/avatar.png"
        alt="Portrait of Rakshit Gumber"
        class="object-cover object-top h-full w-full"
        loading="eager"
      />
    </div>
    <div class="">
      <p
        class="font-content text-xl font-semibold leading-relaxed text-text-color sm:text-2xl"
      >
        Driven by curiosity, Building with Passion.
      </p>
      <Anchor url="https://www.linkedin.com/in/gumber-rakshit" external>
        <button class="px">Let's work </button>
      </Anchor>
    </div>
  </div>
  <h1
    class="font-heading text-4xl font-bold tracking-tight text-title-color sm:text-6xl lg:col-span-2 lg:text-left lg:text-7xl"
  >
    Rakshit Gumber
  </h1>
</div>
