---
import type { ProjectFrontmatter } from "../../libs/types";
import Anchor from "../common/Anchor.astro";
import ProjectSnippet from "../ProjectSnippet.astro";

type Props = {
  featuredProjects: Array<ProjectFrontmatter>;
};

const { featuredProjects } = Astro.props;
---

<div class="flex justify-between items-center w-full" data-reveal>
  <h3 class="font-heading text-2xl font-bold leading-none text-title-color sm:text-3xl">
    Projects
  </h3>
  <Anchor url="/projects" class="text-base">View All</Anchor>
</div>
<ul class="my-8">
  {
    (featuredProjects.length === 0 && <p>No projects found.</p>) ||
      featuredProjects.map((project, index) => (
        <li>
          <ProjectSnippet
            title={project.title}
            description={project.description}
            url={project.url}
            githubUrl={project.githubUrl}
            liveUrl={project.liveDemoUrl}
            tags={project.tags ?? []}
            revealDelay={index * 90}
          />
        </li>
      ))
  }
</ul>
