---
import Anchor from "./common/Anchor.astro";

export type Props = {
  title: string;
  description: string;
  url: string;
  githubUrl?: string;
  liveUrl?: string;
  tags: string[];
  revealDelay?: number;
};

const { title, description, url, githubUrl, liveUrl, tags, revealDelay } = Astro.props;
---

<div
  class="relative flex flex-col gap-3 mb-8"
  data-reveal
  data-reveal-delay={revealDelay}
>
  <div class="flex flex-col gap-3 sm:flex-row sm:justify-between">
    <Anchor
      url={url}
      class="text-xl font-semibold text-title-color no-underline"
    >
      {title}
    </Anchor>
    <div class="flex gap-2">
      {
        githubUrl ? (
          <Anchor url={githubUrl} class="text-base" external>
            GitHub
          </Anchor>
        ) : null
      }
      {
        liveUrl ? (
          <Anchor url={liveUrl} class="text-base" external>
            Live
          </Anchor>
        ) : null
      }
    </div>
  </div>
  <p class="text-lg transition-colors duration-200">
    {description}
  </p>
</div>
