---
import Anchor from "./common/Anchor.astro";
import Section from "./common/Section.astro";
import { Icon } from "astro-icon/components";

const date = new Date();
const year = date.getFullYear();
---

<footer class="my-8 border-t border-border-color">
  <Section class="flex flex-col items-start gap-4">
    <div class="w-full flex items-center justify-between">
      <p class="text-lg font-bold">Crafted with Caffine and Codex.</p>
      <div
        class="flex flex-col gap-8 pb-4 transition-colors duration-200 sm:flex-row sm:flex-nowrap sm:items-center"
      >
        <div class="flex flex-row gap-4">
          <Anchor url="https://github.com/RakshitGumber">
            <Icon
              name="simple-icons:github"
              class="text-3xl fill-title-color transition-colors duration-200"
            />
          </Anchor>
          <Anchor url="https://x.com/Gumber_Rakshit">
            <Icon
              name="simple-icons:x"
              class="text-3xl fill-title-color transition-colors duration-200"
            />
          </Anchor>
          <Anchor url="https://www.linkedin.com/in/gumber-rakshit">
            <Icon
              name="simple-icons:linkedin"
              class="text-3xl fill-title-color transition-colors duration-200"
            />
          </Anchor>
        </div>
      </div>
    </div>
    <p
      class="text-center text-sm font-medium text-secondary-text transition-colors duration-200"
    >
      &copy; {year}
      Rakshit Gumber. All rights reserved.
    </p>
  </Section>
</footer>
