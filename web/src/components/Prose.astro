---
type Props = {
  class?: string;
};
---

<article
  class="prose
    max-w-none
    font-content
    text-text-color
    
    prose-headings:font-heading
    prose-headings:text-title-color
    prose-headings:font-bold
    
    prose-a:text-accent
    prose-a:no-underline
    hover:prose-a:underline
    
    prose-strong:text-title-color
    prose-strong:font-bold
    
    prose-code:text-accent
    prose-code:bg-border-color/30
    prose-code:px-1
    prose-code:py-0.5
    prose-code:rounded-sm
    prose-code:font-mono
    prose-code:before:content-none
    prose-code:after:content-none
    
    prose-blockquote:border-l-accent
    prose-blockquote:text-secondary-text
    prose-blockquote:font-normal
    prose-blockquote:not-italic
    
    prose-hr:border-border-color"
  data-reveal
  data-reveal-delay="140"
>
  <slot />
</article>
