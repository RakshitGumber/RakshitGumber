---
type Props = {
  class?: string;
};

const { class: customClass } = Astro.props;
---

<div
  class="prose prose-h1:text-2xl prose-h2:text-2xl prose-h3:text-xl prose-h4:text-lg prose-h5:text-base prose-h6:text-sm prose-a:text-title-color prose-a:underline-offset-4 prose-a:focus:outline-2 prose-a:focus:outline-offset-2 prose-a:focus:outline-accent prose-code:text-title-color prose-headings:font-mono prose-headings:text-title-color prose-img:rounded-none prose-li:text-text-color prose-ol:marker:text-accent prose-p:text-justify prose-p:text-text-color prose-strong:text-title-color prose-ul:marker:text-accent w-full font-mono"
  class:list={customClass ? [customClass] : []}
>
  <slot />
</div>
