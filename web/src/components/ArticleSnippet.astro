---
import { processArticleDate } from "../libs/utils";
import Anchor from "./common/Anchor.astro";

export type Props = {
  title: string;
  description: string;
  url: string;
  duration?: string;
  timestamp?: Date;
  revealDelay?: number;
};

const { title, description, url, duration, timestamp, revealDelay } = Astro.props;
---

<div
  class="relative mb-8 flex flex-col gap-3 text-text-color transition-colors duration-200 hover-zag-dotted-grid"
  data-reveal
  data-reveal-delay={revealDelay}
>
  <Anchor url={url} class="text-xl font-semibold text-title-color no-underline">
    {title}
  </Anchor>
  <p class="">
    {description}
  </p>
  <div class="flex items-center justify-between text-secondary-text transition-colors duration-200">
    {timestamp ? <p>{processArticleDate(timestamp)}</p> : null}
    {duration ? <p>{duration}</p> : null}
  </div>
</div>
