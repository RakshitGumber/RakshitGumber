---
import Anchor from "./common/Anchor.astro";
import ThemeToggle from "./ThemeToggle.astro";
import { Icon } from "astro-icon/components";

const pathname = Astro.url.pathname;
const navItems = [
  { label: "work", url: "/" },
  { label: "projects", url: "/projects" },
  { label: "blog", url: "/blog" },
];

const isActivePath = (url: string) =>
  url === "/" ? pathname === "/" : pathname === url || pathname.startsWith(`${url}/`);
---

<header class="sticky top-0 z-20 w-full border-b border-border-color bg-bg/95 backdrop-blur-sm transition-colors duration-200">
  <div
    class="relative z-50 flex items-center justify-between bg-bg/95 px-4 py-5 transition-colors duration-200 sm:hidden"
  >
    <Anchor
      url="https://github.com/RakshitGumber"
      class="text-title-color"
      aria-label="Rakshit Gumber GitHub Profile"
    >
      <Icon
        name="simple-icons:github"
        class="text-2xl text-title-color transition-colors duration-200"
      />
    </Anchor>
    <button type="button" aria-label="Toggle navigation menu">
      <svg
        xmlns="http://www.w3.org/2000/svg"
        width="32"
        height="32"
        viewBox="0 0 512 512"
        class="fill-title-color transition-colors duration-200"
      >
        <title>Navigation menu</title>
        <path d="M80 96h352v32H80zm0 144h352v32H80zm0 144h352v32H80z"></path>
      </svg>
    </button>
  </div>
  <nav
    class="fixed inset-x-0 top-0 mx-auto flex h-auto max-w-4xl flex-col gap-10 border-b border-border-color bg-bg px-4 py-6 text-xl transition-colors duration-200 sm:relative sm:flex-row sm:items-center sm:justify-end sm:gap-12 sm:border-none sm:px-6"
  >
    <div
      class="mt-20 flex flex-col items-start gap-5 font-content text-lg font-semibold sm:mt-0 sm:flex-row sm:items-center sm:justify-end sm:gap-8"
    >
      {
        navItems.map((item) => (
          <Anchor
            url={item.url}
            class:list={[
              "uppercase tracking-[0.16em]",
              isActivePath(item.url)
                ? "text-title-color"
                : "text-text-color",
            ]}
          >
            {item.label}
          </Anchor>
        ))
      }
    </div>
    <div class="flex items-center justify-between gap-5 sm:justify-end">
      <Anchor
        url="https://github.com/RakshitGumber"
        class="text-title-color"
        aria-label="Rakshit Gumber GitHub Profile"
      >
        <Icon
          name="simple-icons:github"
          class="text-2xl text-title-color transition-colors duration-200"
        />
      </Anchor>
      <ThemeToggle />
    </div>
  </nav>
</header>

<script>
  const button = document.querySelector("header button") as HTMLButtonElement;
  const nav = document.querySelector("header nav") as HTMLElement;
  let isOpen = false;

  function updateNavState() {
    const isMobile = window.matchMedia("(max-width: 640px)").matches;
    if (isMobile) {
      nav.style.transform = isOpen ? "translateY(0)" : "translateY(-100%)";
    } else {
      nav.style.transform = "translateY(0)";
      isOpen = false;
    }
  }

  function toggleNav() {
    isOpen = !isOpen;
    updateNavState();
  }

  button?.addEventListener("click", toggleNav);
  window.addEventListener("resize", updateNavState);

  updateNavState();
</script>
